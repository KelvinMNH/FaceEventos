# Ambiente
NODE_ENV=production
# Gere uma chave forte e aleatória para assinar os tokens (ex: unieventos_homol_chave_secreta)
JWT_SECRET=sua_chave_secreta_aqui
# URL onde o frontend será acessado publicamente (ex: https://unieventos.unimedmaceio.com.br)
FRONTEND_URL=http://localhost:5174

# Banco de Dados Oracle (As conexões internas do Docker usam a rede unieventos-net)
DB_DIALECT=oracle
DB_HOST=oracle-db
DB_PORT=1521
DB_NAME=FREEPDB1
DB_SERVICE_NAME=FREEPDB1
# Defina senhas fortes para o banco de dados
DB_USER=unieventos
DB_PASS=insira_senha_do_usuario_aqui
DB_ROOT_PASS=insira_senha_sys_aqui

# API Externa CoopMais (Unimed Maceió) - Sincronização de Participantes
COOPMAIS_API_URL=https://api.unimedmaceio.com.br
COOPMAIS_EMAIL=auto.atend.recep@unimedmaceio.com.br
COOPMAIS_PASSWORD=insira_senha_da_api_aqui

# Estratégia de Autenticação (local ou ad)
AUTH_STRATEGY=local
